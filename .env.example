# Token de integração do Notion (deixe vazio para usar mocks locais)
NOTION_TOKEN=

# Chave secreta para acessar os relatórios em /r/[chave]
REPORT_ACCESS_KEY=sua-chave-secreta-aqui

# Chave para POST /api/revalidate, POST /api/enviar-relatorio e cron relatorio-mensal.
# Aceita Authorization: Bearer, cabeçalho x-revalidate-secret ou ?secret=
REVALIDATE_SECRET=outra-chave-secreta-aqui

# SMTP (relatório mensal por e-mail)
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true  # use true na porta 465
EMAIL_REMETENTE=marketing@seudominio.com.br
EMAIL_DESTINATARIOS=destino1@seudominio.com.br,destino2@seudominio.com.br
